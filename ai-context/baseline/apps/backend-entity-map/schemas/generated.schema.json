{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/schemas/backend-entity-map/generated.schema.json",
  "title": "Backend Entity Map generated data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "elements", "relations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "backendRoots", "generator", "coverage"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "backendRoots": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "generator": { "const": "aic-collect-backend-entities" },
        "coverage": { "enum": ["empty", "sample", "full"] }
      }
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "inherited": { "type": "boolean" },
        "declaredIn": { "type": "string", "minLength": 1 }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "qualifiedName", "module", "sourcePath", "line", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["entity", "enum", "inner-class"] },
        "name": { "type": "string", "minLength": 1 },
        "qualifiedName": { "type": "string", "minLength": 1 },
        "module": { "type": "string" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "descriptionSource": { "enum": ["documentation", "inferred", "missing"] },
        "parentId": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "values": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["contains", "extends", "implements", "references", "uses"] },
        "label": { "type": "string" }
      }
    }
  }
}
