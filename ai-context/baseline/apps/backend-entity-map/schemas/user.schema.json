{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/schemas/backend-entity-map/user.schema.json",
  "title": "Backend Entity Map user data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "elements", "relations", "annotations", "layout"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "generated.schema.json#/$defs/relation" }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId"],
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "color": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "inherited": { "type": "boolean" },
        "declaredIn": { "type": "string", "minLength": 1 }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["entity", "enum", "inner-class"] },
        "name": { "type": "string", "minLength": 1 },
        "qualifiedName": { "type": "string" },
        "module": { "type": "string" },
        "sourcePath": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "values": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
