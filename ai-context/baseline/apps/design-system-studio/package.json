{
  "name": "@ai-context/design-system-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/public-api.ts",
    "./types": "./src/types.ts",
    "./renderers": "./src/renderers.tsx",
    "./schema": "./schemas/studio.schema.json",
    "./project-schema": "./schemas/project.schema.json"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs --production",
    "validate:data": "node scripts/validate-data.mjs",
    "split:data": "node scripts/split-studio-data.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
