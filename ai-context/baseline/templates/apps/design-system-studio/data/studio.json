            { "id": "profile-status", "componentId": "badge", "props": { "label": "Данные заполнены" } },
            { "id": "profile-name", "componentId": "input", "state": "focus", "props": { "label": "Отображаемое имя", "placeholder": "{{userName}}" } },
            { "id": "profile-clear", "componentId": "button", "variant": "secondary", "props": { "label": "Показать empty state" }, "actionId": "clear-profile" }
